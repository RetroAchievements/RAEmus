        MENUITEM "", IDM_MON_DRIVE9
        MENUITEM "", IDM_MON_DRIVE10
        MENUITEM "", IDM_MON_DRIVE11
    END
    POPUP "Window"
    BEGIN
        MENUITEM "", IDM_MON_CASCADE
        MENUITEM "", IDM_MON_TILE_VERT
        MENUITEM "", IDM_MON_TILE_HORIZ
        MENUITEM "", IDM_MON_ARRANGE_ICONS
    END
END

